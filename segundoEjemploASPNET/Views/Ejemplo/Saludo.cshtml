<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card text-center shadow">
                <div class="card-header bg-primary text-white">
                    <h4>Datos del Usuario</h4>
                </div>
                <div class="card-body">
                    <p><strong>Nombre:</strong> @ViewBag.nombre</p>
                    <p><strong>Edad:</strong> @ViewBag.edad</p>
                    <p><strong>Casado:</strong> @ViewBag.casado</p>
                    <p><strong>Estatura:</strong> @ViewBag.estatura</p>
                    <p><strong>Fecha de nacimiento:</strong> @ViewBag.fechaNacimiento.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>
    </div>
</div>