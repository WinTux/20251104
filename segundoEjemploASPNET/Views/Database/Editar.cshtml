@model para.ddbb.Producto

<h3 class="mt-4 mb-3 text-primary">Edición de producto</h3>

<form method="post" asp-controller="Database" asp-action="Editar" class="p-4 border rounded shadow-sm bg-light">

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre:</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Precio" class="form-label">Precio:</label>
        <input asp-for="Precio" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Cantidad" class="form-label">Cantidad:</label>
        <input asp-for="Cantidad" type="number" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo" type="checkbox" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label">Activo</label>
    </div>
    <input type="hidden" asp-for="Id"/>

    <button type="submit" class="btn btn-primary w-100">
        Registrar Producto
    </button>

</form>
