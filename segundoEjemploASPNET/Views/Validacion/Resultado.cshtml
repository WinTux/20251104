<h3>Detalles de la cuenta registrada</h3>
<table>
    <tr>
        <td>Usuario:</td>
        <td>@ViewBag.cuenta.Usuario</td>
    </tr>
    <tr>
        <td>Password:</td>
        <td>@ViewBag.cuenta.Password</td>
    </tr>
    <tr>
        <td>Edad:</td>
        <td>@ViewBag.cuenta.Edad</td>
    </tr>
    <tr>
        <td>Email:</td>
        <td>@ViewBag.cuenta.email</td>
    </tr>
    <tr>
        <td>WEB:</td>
        <td>@ViewBag.cuenta.sitioWeb</td>
    </tr>
</table>