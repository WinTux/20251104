@model segundoEjemploASPNET.Models.CuentaViewModel
<div class="container">
    <div class="row">
        <div class="col-3 offset-md-3"></div>
                <div class="col-6">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Registro Desarrollador</h3>
        </div>
        <div class="card-body">
            <form asp-controller="Cuenta" asp-action="Registrar" method="post">

                <div class="mb-3">
                    <label class="form-label">Usuario:</label>
                    <input asp-for="Cuenta.Usuario" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password:</label>
                    <input type="password" asp-for="Cuenta.Password" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción:</label>
                    <textarea cols="20" rows="5" asp-for="Cuenta.Descripcion" class="form-control"></textarea>
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" asp-for="Cuenta.Disponible" class="form-check-input" id="disponible" />
                    <label class="form-check-label" for="disponible">Disponible</label>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Género:</label>
                    <div class="form-check form-check-inline">
                        <input type="radio" value="F" asp-for="Cuenta.Genero" class="form-check-input" id="generoF" />
                        <label class="form-check-label" for="generoF">Femenino</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" value="M" asp-for="Cuenta.Genero" class="form-check-input" id="generoM" />
                        <label class="form-check-label" for="generoM">Masculino</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Lenguajes:</label>
                    @for (var i = 0; i < Model.Lenguajes.Count; i++)
                    {
                        <input type="hidden" asp-for="@Model.Lenguajes[i].Id" />
                        <input type="hidden" asp-for="@Model.Lenguajes[i].Nombre" />
                        <div class="form-check">
                            <input type="checkbox" asp-for="@Model.Lenguajes[i].estaMarcado" class="form-check-input" id="lenguaje_@i" />
                            <label class="form-check-label" for="lenguaje_@i">@Model.Lenguajes[i].Nombre</label>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Cargo anterior:</label>
                    <select asp-for="Cuenta.Cargo" asp-items="@Model.Cargos" class="form-select"></select>
                </div>

                <input type="hidden" asp-for="Cuenta.Id" />

                <div class="d-grid">
                    <button type="submit" class="btn btn-success">Registrar</button>
                </div>
            </form>
        </div>
            </div>
    </div>
    </div>
</div>