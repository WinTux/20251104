<h3 class="mb-4">Lista de productos</h3>

<table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Foto</th>
            <th>Comprar</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in ViewBag.Productos)
        {
            <tr>
                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>$@producto.Precio</td>
                <td>
                    <img src="~/imagenes/@producto.Foto" alt="@producto.Nombre" class="img-thumbnail" style="height: 100px;" />
                </td>
                <td class="text-center">
                    <a class="btn btn-primary btn-sm"
                       asp-controller="Carrito"
                       asp-action="Agregar"
                       asp-route-id="@producto.Id">
                        Agregar al carrito
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
